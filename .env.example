# Имя WireGuard-интерфейса
WG_IF=wg0

# Путь к WireGuard-конфигу
WG_CONF=/etc/wireguard/wg0.conf

# Public key WireGuard-сервера. scripts/preinstall-wg.sh выводит готовое значение.
WG_SERVER_PUB=

# Публичный endpoint сервера: IP или домен + порт
WG_ENDPOINT=example.com:51820

# DNS-серверы для клиентов
WG_DNS=1.1.1.1,8.8.8.8

# VPN-подсеть
WG_NET=10.0.70.0/24

# HTTP-порт панели
PORT=54763

# IP, на котором слушает Node.js. Для nginx оставьте 127.0.0.1.
HOST=127.0.0.1

# Внешний адрес панели. Для пути /wg-easy укажите домен вместе с путём.
# Пример: PUBLIC_URL=https://vpn.example.com/wg-easy
PUBLIC_URL=

# Можно задать путь вручную, если PUBLIC_URL не используется.
# Пример: PUBLIC_BASE_PATH=/wg-easy
PUBLIC_BASE_PATH=

# Для локальной разработки без WireGuard укажите false
AUTO_START_WG=true

# Логин и пароль администратора
ADMIN_USER=admin
ADMIN_PASS=ChangeMe_StrongPassword

# Дополнительные разрешённые IP или CIDR через запятую.
# Для прямого доступа с любых IPv4: ALLOWED_IPS=0.0.0.0/0
ALLOWED_IPS=

# Каталог runtime-данных: peers.json и clients/*.conf
# BASE_DIR=/opt/wg-dashboard
