# WireGuard interface name
WG_IF=wg0

# Path to WireGuard config
WG_CONF=/etc/wireguard/wg0.conf

# Public key of your WireGuard server
WG_SERVER_PUB=

# Public endpoint of your server (IP or domain + port)
WG_ENDPOINT=example.com:51820

# DNS servers pushed to clients
WG_DNS=1.1.1.1,8.8.8.8

# VPN subnet
WG_NET=10.0.70.0/24

# Dashboard listen port
PORT=54763

# Basic auth credentials
ADMIN_USER=admin
ADMIN_PASS=ChangeMe_StrongPassword

# Optional extra allowed admin IPs (comma-separated)
ALLOWED_IPS=

# Optional base dir for storing dashboard data (peers.json, clients/*.conf)
# BASE_DIR=/opt/wg-dashboard
